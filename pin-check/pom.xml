<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Standalone (non-reactor, non-deployable) virtual-thread PINNING check for the JFalkorDB client.

      Wave 5 (Project Loom, #333) verifies that the blocking client does not pin carrier threads when
      driven from virtual threads on JDK 21+. This module warms the connection pool (so cold
      commons-pool2 connection creation runs off the measured path), then runs a virtual-thread query
      workload over the warm pool under a JFR recording. `-Djdk.tracePinnedThreads=full` makes the JVM
      mark the frames that hold the monitor on each pinned stack, and the check fails if one of them is
      in our `com.falkordb.impl` client internals. Pins whose monitor a dependency holds (commons-pool2
      2.13+ returning a connection under contention) are reported, not failed. It compiles at release 21
      (it uses virtual threads + the JFR API directly) and is never part of the main reactor or the
      published artifact.
      Run via `just pin-check`; wired as the scheduled `pin-check` CI job.
    -->
    <groupId>com.falkordb.pin</groupId>
    <artifactId>jfalkordb-pin-check</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.deploy.skip>true</maven.deploy.skip>
        <gpg.skip>true</gpg.skip>
        <!-- Overridden by `just pin-check` with the root project's actual version; the default keeps
             the module runnable stand-alone against the current -SNAPSHOT.
             Kept current by release-please via its x-release-please-version marker. -->
        <jfalkordb.version>0.16.1-SNAPSHOT</jfalkordb.version> <!-- x-release-please-version -->
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.falkordb</groupId>
            <artifactId>jfalkordb</artifactId>
            <version>${jfalkordb.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>2.0.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <!-- JDK 21-23: print each distinct pinned stack with its monitor holders marked, which
                         VirtualThreadPinningTest uses to attribute a pin. Read once at JVM start, so it
                         must be a JVM argument; JDK 24+ ignores it. -->
                    <argLine>-Djdk.tracePinnedThreads=full</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
